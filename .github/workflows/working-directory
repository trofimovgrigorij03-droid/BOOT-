name: Build Windows EXE

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest
    defaults:
      run:
        working-directory: PORT_BOT_CHILIAD_V2   # 👈 добавь эту строку
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install deps
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          pip install pyinstaller

      - name: Build EXE
        run: |
          pyinstaller --onefile --name PORT_BOT_CHILIAD port_bot.py

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: PORT_BOT_CHILIAD-Windows-x64
          path: |
            PORT_BOT_CHILIAD_V2/dist/PORT_BOT_CHILIAD.exe
            PORT_BOT_CHILIAD_V2/config.json
